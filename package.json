{
  "name": "time-station-electron",
  "version": "1.3.0",
  "description": "智慧桌曆與氣象站 - Raspberry Pi 7吋觸控螢幕",
  "main": "electron/main.js",
  "author": "wkchen",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs && npm run build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder --linux --arm64",
    "electron:build:appimage": "npm run build && electron-builder --linux appimage --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/openai": "^1.5.11",
    "solarlunar": "^3.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.timestation.app",
    "productName": "TimeStation",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}